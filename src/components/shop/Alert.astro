---
/**
 * Flash messages and inline notices.
 *
 * An error gets role="alert" so a screen reader interrupts and reads it — that
 * is the one case where interrupting is right, because the customer's last
 * action did not go through. Everything else is role="status", announced when
 * the user is next idle.
 */

type Kind = 'success' | 'error' | 'info' | 'warning';

interface Props {
  kind: Kind;
  title?: string;
  class?: string;
}

const { kind, title, class: className } = Astro.props;

const STYLES: Record<Kind, string> = {
  success: 'border-emerald-600/30 bg-emerald-50 text-emerald-950',
  error: 'border-red-600/30 bg-red-50 text-red-950',
  info: 'border-sky-600/30 bg-sky-50 text-sky-950',
  warning: 'border-amber-600/30 bg-amber-50 text-amber-950',
};

const ICON_COLOURS: Record<Kind, string> = {
  success: 'text-emerald-700',
  error: 'text-red-700',
  info: 'text-sky-700',
  warning: 'text-amber-700',
};

// A shape per kind, so the notice still reads correctly in greyscale or to
// someone who cannot separate the four background tints.
const ICONS: Record<Kind, string> = {
  success: 'M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm3.78 6.34a.75.75 0 0 0-1.06-1.06L9 10.5 7.28 8.78a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.06 0l4.25-4.25Z',
  error:
    'M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM7.72 6.66a.75.75 0 0 0-1.06 1.06L8.94 10l-2.28 2.28a.75.75 0 1 0 1.06 1.06L10 11.06l2.28 2.28a.75.75 0 1 0 1.06-1.06L11.06 10l2.28-2.28a.75.75 0 0 0-1.06-1.06L10 8.94 7.72 6.66Z',
  info: 'M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM10 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm.75 4.25a.75.75 0 0 0-1.5 0v5a.75.75 0 0 0 1.5 0v-5Z',
  warning:
    'M8.7 2.6a1.5 1.5 0 0 1 2.6 0l7 12.15a1.5 1.5 0 0 1-1.3 2.25H3a1.5 1.5 0 0 1-1.3-2.25L8.7 2.6ZM9.25 7.5a.75.75 0 0 1 1.5 0v4a.75.75 0 0 1-1.5 0v-4ZM10 13.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
};

const LABELS: Record<Kind, string> = {
  success: 'Success',
  error: 'Error',
  info: 'Note',
  warning: 'Warning',
};
---

<div
  role={kind === 'error' ? 'alert' : 'status'}
  class:list={['flex gap-3 rounded-2xl border px-4 py-3.5 text-sm leading-relaxed', STYLES[kind], className]}
>
  <svg
    class:list={['mt-0.5 size-5 shrink-0', ICON_COLOURS[kind]]}
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path fill-rule="evenodd" clip-rule="evenodd" d={ICONS[kind]}></path>
  </svg>

  <div class="min-w-0 flex-1">
    <span class="sr-only">{LABELS[kind]}: </span>
    {title && <p class="font-semibold">{title}</p>}
    <div class:list={[title && 'mt-1', 'text-current/85 [&_a]:font-medium [&_a]:underline']}>
      <slot />
    </div>
  </div>
</div>
