---
/**
 * Shown wherever a list comes back empty — an empty cart, no orders yet, a
 * search with no matches. Always offers a way out rather than a dead end.
 */

interface Props {
  title: string;
  body?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, body, actionHref, actionLabel } = Astro.props;

// Button.astro is deliberately not imported: these components stay independent
// of each other so any one of them can be changed without a chain reaction.
const ACTION =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-spice-500 px-6 text-sm font-medium ' +
  'text-cream no-underline shadow-lg shadow-spice-700/20 transition hover:bg-spice-700 focus-visible:outline-none ' +
  'focus-visible:ring-2 focus-visible:ring-spice-500 focus-visible:ring-offset-2 focus-visible:ring-offset-cream';
---

<div class="rounded-3xl border border-mango-100 bg-white/60 px-6 py-14 text-center">
  <h2 class="font-serif text-xl font-semibold text-ink sm:text-2xl">{title}</h2>

  {body && <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink/65">{body}</p>}

  {
    actionHref && actionLabel && (
      <p class="mt-7">
        <a href={actionHref} class={ACTION}>
          {actionLabel}
        </a>
      </p>
    )
  }

  <slot />
</div>
