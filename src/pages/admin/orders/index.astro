---
/**
 * The order queue.
 *
 * Filtering and paging are a plain GET form, so the whole screen works with
 * scripting off and — more usefully — every view is a URL. "Show me everything
 * awaiting payment" is a link somebody can bookmark, and the dashboard tiles
 * link straight into it.
 *
 * There is no bulk selection on purpose. Advancing twenty orders at once means
 * twenty state transitions nobody read, and at this shop's volume the fulfilment
 * screen is one tap away.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/shop/StatusBadge.astro';
import { readPaging, requireAdmin, requireCtx } from '../../../lib/api';
import type { OrderStatus } from '../../../lib/db/types';
import { formatPaise } from '../../../lib/money';
import { listOrders, STATUS_LABEL } from '../../../lib/services/orders';

export const prerender = false;

if (!requireCtx(Astro.locals).isAdmin) {
  return Astro.redirect(`/account/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
const { ctx } = requireAdmin(Astro.locals);

const { limit, offset } = readPaging(Astro.url, 25, 100);
const page = Math.max(Number.parseInt(Astro.url.searchParams.get('page') ?? '', 10) || 1, 1);

// Checked against the known set rather than passed through: a bogus status would
// otherwise bind cleanly, match nothing, and show an empty list as if the shop
// had no orders.
const rawStatus = Astro.url.searchParams.get('status') ?? '';
const status = (Object.keys(STATUS_LABEL) as OrderStatus[]).find((s) => s === rawStatus) ?? null;
const search = (Astro.url.searchParams.get('search') ?? '').trim().slice(0, 120);

const result = await listOrders(ctx.db, { status, search: search || null, limit, offset });

const from = result.total === 0 ? 0 : offset + 1;
const to = offset + result.items.length;

/** Keep the filters when only the page changes. */
function pageHref(target: number): string {
  const params = new URLSearchParams();
  if (status) params.set('status', status);
  if (search) params.set('search', search);
  if (limit !== 25) params.set('limit', String(limit));
  if (target > 1) params.set('page', String(target));
  const query = params.toString();
  return query ? `/admin/orders?${query}` : '/admin/orders';
}

const stamp = (ms: number) =>
  new Date(ms).toLocaleString('en-IN', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Kolkata',
  });

/** Compact age — "2h", "3d". How long something has been waiting is the whole point. */
function age(ms: number): string {
  const minutes = Math.floor((Date.now() - ms) / 60000);
  if (minutes < 1) return 'now';
  if (minutes < 60) return `${minutes}m`;
  const hours = Math.floor(minutes / 60);
  if (hours < 48) return `${hours}h`;
  return `${Math.floor(hours / 24)}d`;
}

const TH = 'px-3 py-2 text-left text-[11px] font-semibold tracking-wide text-ink/55 uppercase whitespace-nowrap';
const TD = 'px-3 py-2 align-middle';
const CONTROL =
  'min-h-9 rounded-md border border-ink/15 bg-white px-2.5 py-1.5 text-sm text-ink transition ' +
  'focus:border-spice-500 focus:ring-2 focus:ring-spice-500/20 focus:outline-none';
const PAGER =
  'inline-flex min-h-9 items-center rounded-md border border-ink/15 bg-white px-3 text-sm transition ' +
  'hover:border-ink/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spice-500';
---

<AdminLayout
  title="Orders"
  subtitle={`${result.total} ${result.total === 1 ? 'order' : 'orders'} matching${status ? ` · ${STATUS_LABEL[status]}` : ''}${search ? ` · “${search}”` : ''}`}
>
  <form method="get" action="/admin/orders" class="flex flex-wrap items-end gap-2">
    <div>
      <label for="filter-status" class="mb-1 block text-[11px] font-semibold tracking-wide text-ink/55 uppercase">
        Status
      </label>
      <select id="filter-status" name="status" class={CONTROL}>
        <option value="">All statuses</option>
        {
          (Object.keys(STATUS_LABEL) as OrderStatus[]).map((value) => (
            <option value={value} selected={status === value}>
              {STATUS_LABEL[value]}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="filter-search" class="mb-1 block text-[11px] font-semibold tracking-wide text-ink/55 uppercase">
        Search
      </label>
      <input
        id="filter-search"
        name="search"
        type="search"
        value={search}
        maxlength="120"
        placeholder="Order number, name, email, phone"
        class:list={[CONTROL, 'w-56']}
      />
    </div>

    <button
      type="submit"
      class="min-h-9 rounded-md bg-spice-500 px-3 text-sm font-medium text-cream transition hover:bg-spice-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spice-500 focus-visible:ring-offset-2"
    >
      Apply
    </button>

    {
      (status || search) && (
        <a href="/admin/orders" class="min-h-9 px-1 py-2 text-sm text-ink/60 underline underline-offset-2 hover:text-spice-500">
          Clear
        </a>
      )
    }
  </form>

  <div class="mt-4 rounded-md border border-ink/10 bg-white">
    {
      result.items.length === 0 ? (
        <p class="px-3 py-10 text-center text-sm text-ink/55">
          Nothing matches that filter. <a href="/admin/orders" class="underline underline-offset-2">Show every order</a>.
        </p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <caption class="sr-only">
              Orders {from} to {to} of {result.total}
            </caption>
            <thead class="border-b border-ink/10 bg-cream/60">
              <tr>
                <th scope="col" class={TH}>
                  Order
                </th>
                <th scope="col" class={TH}>
                  Placed
                </th>
                <th scope="col" class={TH}>
                  Customer
                </th>
                <th scope="col" class={TH}>
                  Items
                </th>
                <th scope="col" class={TH}>
                  Payment
                </th>
                <th scope="col" class={`${TH} text-right`}>
                  Total
                </th>
                <th scope="col" class={TH}>
                  Status
                </th>
              </tr>
            </thead>
            <tbody>
              {result.items.map(({ order, itemCount, firstItemName }) => (
                <tr class="border-b border-ink/8 last:border-0 hover:bg-mango-50">
                  <td class={TD}>
                    <a
                      href={`/admin/orders/${order.id}`}
                      class="font-medium underline decoration-ink/25 underline-offset-2 hover:text-spice-500 hover:decoration-spice-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spice-500"
                    >
                      {order.order_number}
                    </a>
                    {order.is_guest === 1 && <span class="ml-1 text-[11px] text-ink/45">guest</span>}
                  </td>

                  <td class={`${TD} whitespace-nowrap`}>
                    <span class="text-xs text-ink/70 tabular-nums">{stamp(order.placed_at)}</span>
                    <span class="ml-1 text-[11px] text-ink/45 tabular-nums">{age(order.placed_at)}</span>
                  </td>

                  <td class={`${TD} max-w-48`}>
                    <span class="block truncate">{order.customer_name}</span>
                    <span class="block truncate text-[11px] text-ink/50">{order.email}</span>
                  </td>

                  <td class={`${TD} max-w-44`}>
                    <span class="block truncate text-xs text-ink/70" title={firstItemName}>
                      {firstItemName || '—'}
                    </span>
                    <span class="text-[11px] text-ink/45 tabular-nums">
                      {itemCount} {itemCount === 1 ? 'jar' : 'jars'}
                    </span>
                  </td>

                  <td class={TD}>
                    <span class="block text-xs">{order.payment_method === 'cod' ? 'Cash on delivery' : 'Prepaid'}</span>
                    <StatusBadge status={order.payment_status} kind="payment" />
                  </td>

                  <td class={`${TD} text-right whitespace-nowrap tabular-nums`}>
                    {formatPaise(order.total_paise)}
                    {order.refunded_paise > 0 && (
                      <span class="block text-[11px] text-ink/50">−{formatPaise(order.refunded_paise)} refunded</span>
                    )}
                  </td>

                  <td class={TD}>
                    <StatusBadge status={order.status} kind="order" />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <nav aria-label="Pagination" class="mt-3 flex items-center justify-between gap-3 text-sm">
    <p class="text-ink/60 tabular-nums">
      {from}–{to} of {result.total}
    </p>
    <div class="flex gap-2">
      {page > 1 && <a href={pageHref(page - 1)} class={PAGER} rel="prev">← Newer</a>}
      {offset + result.items.length < result.total && (
        <a href={pageHref(page + 1)} class={PAGER} rel="next">Older →</a>
      )}
    </div>
  </nav>
</AdminLayout>
