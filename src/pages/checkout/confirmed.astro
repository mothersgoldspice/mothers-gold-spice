---
/**
 * Thank you.
 *
 * The last page of the checkout and the first page of the wait, so it answers
 * the three questions a customer actually has: what did I buy, where is it
 * going, and when will it turn up. Everything is read from the order snapshot,
 * never from the catalogue — this is what they bought at the price they paid.
 *
 * A guest reaches it with the derived access token in `?t=`, the same token
 * their receipt email carries.
 */
import Alert from '../../components/shop/Alert.astro';
import Button from '../../components/shop/Button.astro';
import Money from '../../components/shop/Money.astro';
import ShopLayout from '../../components/shop/ShopLayout.astro';
import StatusBadge from '../../components/shop/StatusBadge.astro';
import { requireCtx } from '../../lib/api';
import { publicMessage } from '../../lib/errors';
import { assertOrderAccess, getOrderById, loadOrderView } from '../../lib/services/orders';
import { getShipmentForOrder } from '../../lib/services/shipments';
import { ZONE_ETD_DAYS, zoneForPincode } from '../../lib/shipping-zones';

export const prerender = false;

const ctx = requireCtx(Astro.locals);
const settings = await ctx.settings();

const orderId = Astro.url.searchParams.get('order') ?? '';
const token = Astro.url.searchParams.get('t');

let view: Awaited<ReturnType<typeof loadOrderView>> | null = null;
let problem = '';

if (!orderId) {
  Astro.response.status = 404;
  problem = 'We could not find that order.';
} else {
  const order = await getOrderById(ctx.db, orderId);
  if (!order) {
    Astro.response.status = 404;
    problem = 'We could not find that order.';
  } else {
    try {
      await assertOrderAccess(ctx, order, token);
      view = await loadOrderView(ctx.db, order.id);
    } catch (err) {
      Astro.response.status = 403;
      problem = publicMessage(err);
    }
  }
}

const order = view?.order ?? null;
const shipment = order ? await getShipmentForOrder(ctx.db, order.id) : null;

// The estimate: the courier's own date once a parcel exists, otherwise the zone
// table plus a day in the kitchen. Better an honest range than a false promise.
const zone = view ? zoneForPincode(view.shippingAddress.pincode) : null;
const PACKING_DAYS = 1;
const etaAt =
  shipment?.estimated_delivery_at ??
  (order && zone ? order.placed_at + (ZONE_ETD_DAYS[zone] + PACKING_DAYS) * 24 * 60 * 60 * 1000 : null);

const asDate = (at: number) =>
  new Date(at).toLocaleDateString('en-IN', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    timeZone: 'Asia/Kolkata',
  });

const tokenQuery = token ? `?t=${encodeURIComponent(token)}` : '';
const trackHref = order
  ? ctx.user && order.user_id === ctx.user.id && order.is_guest !== 1
    ? `/account/orders/${order.id}`
    : `/track/${order.id}${tokenQuery}`
  : '/track';
const invoiceHref = order ? `/invoice/${order.id}${tokenQuery}` : '/track';

const isCod = order?.payment_method === 'cod';
---

<ShopLayout title={order ? `Order ${order.order_number} confirmed` : 'Order'} user={ctx.user}>
  {
    !order || !view ? (
      <div class="rounded-3xl border border-mango-100 bg-white/60 px-6 py-14 text-center">
        <h1 class="font-serif text-2xl text-ink sm:text-3xl">We cannot show that order</h1>
        <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink/65">
          {problem} Your receipt email carries a link that always works.
        </p>
        <p class="mt-7">
          <Button href="/track">Look up an order</Button>
        </p>
      </div>
    ) : (
      <div>
        <div class="rounded-3xl border border-emerald-600/25 bg-emerald-50 p-6 text-center sm:p-8">
          <p class="text-xs font-semibold tracking-widest text-emerald-800 uppercase">Order confirmed</p>
          <h1 class="mt-2 font-serif text-2xl text-ink sm:text-3xl">Thank you — we have your order</h1>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-emerald-950/80">
            {isCod
              ? 'Nothing to pay now. Keep the exact amount ready for the delivery agent.'
              : 'Your payment has gone through.'}{' '}
            A receipt is on its way to {order.email}.
          </p>

          <p class="mt-5 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-2xl bg-white/70 px-4 py-2">
            <span class="text-sm text-ink/70">Order number</span>
            <span class="font-serif text-lg font-semibold text-ink">{order.order_number}</span>
            <StatusBadge status={order.status} />
          </p>
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {/* ── Delivery ─────────────────────────────────────────────── */}
          <section class="rounded-3xl border border-mango-100 bg-white/70 p-5" aria-labelledby="delivery-heading">
            <h2 id="delivery-heading" class="font-serif text-lg font-semibold text-ink">
              Going to
            </h2>
            <address class="mt-2 text-sm leading-relaxed text-ink/75 not-italic">
              <span class="block font-medium text-ink">{view.shippingAddress.full_name}</span>
              {view.shippingAddress.line1}
              {view.shippingAddress.line2 && <>, {view.shippingAddress.line2}</>}
              <br />
              {view.shippingAddress.landmark && (
                <>
                  {view.shippingAddress.landmark}
                  <br />
                </>
              )}
              {view.shippingAddress.city}, {view.shippingAddress.state} {view.shippingAddress.pincode}
              <br />
              {view.shippingAddress.phone}
            </address>

            {etaAt && (
              <p class="mt-4 rounded-2xl bg-mango-50/70 px-4 py-3 text-sm">
                <span class="block text-ink/70">Expected delivery</span>
                <span class="font-semibold text-ink">around {asDate(etaAt)}</span>
              </p>
            )}
          </section>

          {/* ── What happens next ────────────────────────────────────── */}
          <section class="rounded-3xl border border-mango-100 bg-white/70 p-5" aria-labelledby="next-heading">
            <h2 id="next-heading" class="font-serif text-lg font-semibold text-ink">
              What happens next
            </h2>
            <ol class="mt-3 list-none space-y-3 p-0 text-sm leading-relaxed text-ink/75">
              <li class="flex gap-3">
                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-spice-500 text-[11px] font-semibold text-cream">
                  1
                </span>
                <span>We pack your jars by hand, usually the next working day.</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-spice-500 text-[11px] font-semibold text-cream">
                  2
                </span>
                <span>
                  The courier collects the parcel and we email you the tracking number the moment it is on the road.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-spice-500 text-[11px] font-semibold text-cream">
                  3
                </span>
                <span>
                  {isCod ? (
                    <>
                      Pay the agent <Money paise={order.total_paise} /> in cash when it arrives.
                    </>
                  ) : (
                    'It arrives. Refrigerate after opening and use a dry spoon.'
                  )}
                </span>
              </li>
            </ol>

            <p class="mt-4">
              <Button href={trackHref} variant="secondary">Track this order</Button>
            </p>
          </section>
        </div>

        {/* ── What you bought ────────────────────────────────────────── */}
        <section class="mt-6 rounded-3xl border border-mango-100 bg-white/70 p-5" aria-labelledby="items-heading">
          <h2 id="items-heading" class="font-serif text-lg font-semibold text-ink">
            Your order
          </h2>

          <ul class="mt-4 list-none space-y-3 p-0 text-sm">
            {view.items.map((item) => (
              <li class="flex items-start justify-between gap-3">
                <span class="min-w-0 text-ink/80">
                  {item.product_name}
                  <span class="block text-xs text-ink/55">
                    {item.variant_name} × {item.qty}
                  </span>
                </span>
                <Money paise={item.total_paise} class="text-ink" />
              </li>
            ))}
          </ul>

          <dl class="mt-4 space-y-2 border-t border-ink/10 pt-4 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-ink/70">Items</dt>
              <dd><Money paise={order.subtotal_paise} class="text-ink" /></dd>
            </div>
            {order.discount_paise > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/70">Discount{order.coupon_code ? ` (${order.coupon_code})` : ''}</dt>
                <dd class="text-emerald-800">
                  −<Money paise={order.discount_paise} />
                </dd>
              </div>
            )}
            <div class="flex justify-between gap-4">
              <dt class="text-ink/70">Delivery</dt>
              <dd class="text-ink">
                {order.shipping_paise === 0 ? 'Free' : <Money paise={order.shipping_paise} />}
              </dd>
            </div>
            {order.cod_fee_paise > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/70">Cash-handling fee</dt>
                <dd class="text-ink">
                  <Money paise={order.cod_fee_paise} />
                </dd>
              </div>
            )}
            <div class="flex justify-between gap-4 border-t border-ink/10 pt-3 text-base font-semibold">
              <dt>{isCod ? 'Due on delivery' : 'Paid'}</dt>
              <dd><Money paise={order.total_paise} /></dd>
            </div>
          </dl>

          {order.tax_inclusive === 1 && order.tax_paise > 0 && (
            <p class="mt-2 text-xs text-ink/55">
              Includes <Money paise={order.tax_paise} /> GST.
            </p>
          )}

          <p class="mt-4 flex flex-wrap gap-3 text-sm">
            <a href={invoiceHref} class="font-medium text-spice-500 underline underline-offset-4">
              View or print the invoice
            </a>
            <a href="/shop" class="font-medium text-ink/60 underline underline-offset-4">Back to the shop</a>
          </p>
        </section>

        {order.customer_note && (
          <Alert kind="info" title="Your note to us" class="mt-6">
            {order.customer_note}
          </Alert>
        )}

        <p class="mt-6 text-sm leading-relaxed text-ink/60">
          Something not right? Write to
          <a href="mailto:mothersgoldspice@gmail.com" class="font-medium text-spice-500 underline underline-offset-4">
            mothersgoldspice@gmail.com
          </a>
          with your order number{settings.supportPhone && <> or call {settings.supportPhone}</>} and we will sort it out.
        </p>
      </div>
    )
  }
</ShopLayout>
