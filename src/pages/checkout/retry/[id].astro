---
/**
 * Pay for an order that is still waiting for its money.
 *
 * Reached from the "payment did not go through" email and from the return page.
 * The order, its price and its stock reservation all already exist — this page
 * only opens a new gateway session against them, so the customer never has to
 * rebuild a basket or retype an address.
 */
import Alert from '../../../components/shop/Alert.astro';
import Button from '../../../components/shop/Button.astro';
import Money from '../../../components/shop/Money.astro';
import ShopLayout from '../../../components/shop/ShopLayout.astro';
import StatusBadge from '../../../components/shop/StatusBadge.astro';
import { requireCtx } from '../../../lib/api';
import { publicMessage } from '../../../lib/errors';
import type { OrderItemRow } from '../../../lib/db/types';
import { assertOrderAccess, getOrderById, loadOrderView } from '../../../lib/services/orders';

export const prerender = false;

const ctx = requireCtx(Astro.locals);

const orderId = Astro.params.id ?? '';
const token = Astro.url.searchParams.get('t');

let view: Awaited<ReturnType<typeof loadOrderView>> | null = null;
let problem = '';

const order = orderId ? await getOrderById(ctx.db, orderId) : null;

if (!order) {
  Astro.response.status = 404;
  problem = 'We could not find that order.';
} else {
  try {
    await assertOrderAccess(ctx, order, token);
    view = await loadOrderView(ctx.db, order.id);
  } catch (err) {
    Astro.response.status = 403;
    problem = publicMessage(err);
  }
}

// Already settled: the receipt is the right page, not another payment attempt.
if (view && order && (order.payment_status === 'paid' || order.status === 'confirmed')) {
  return Astro.redirect(
    `/checkout/confirmed?order=${encodeURIComponent(order.id)}${token ? `&t=${encodeURIComponent(token)}` : ''}`,
  );
}

/** Why there is nothing to pay here, or null when the button should show. */
const blocked: string | null =
  !order || !view
    ? problem || 'We could not find that order.'
    : order.status === 'cancelled'
      ? 'That order was cancelled and the jars have gone back on the shelf. Nothing is owed.'
      : order.payment_method === 'cod'
        ? 'That order is cash on delivery — pay the agent when the parcel arrives. There is nothing to pay now.'
        : null;

const items: OrderItemRow[] = view?.items ?? [];
---

<ShopLayout title={order ? `Pay for ${order.order_number}` : 'Order'} user={ctx.user}>
  {
    !order || !view ? (
      <div class="rounded-3xl border border-mango-100 bg-white/60 px-6 py-14 text-center">
        <h1 class="font-serif text-2xl text-ink sm:text-3xl">We cannot open that order</h1>
        <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink/65">
          {problem} The link in your email always works, or you can look the order up with your order number and email
          address.
        </p>
        <p class="mt-7">
          <Button href="/track">Look up an order</Button>
        </p>
      </div>
    ) : (
      <div data-retry data-order-id={order.id} data-token={token ?? ''}>
        <h1 class="font-serif text-3xl text-ink sm:text-4xl">Finish paying for your order</h1>
        <p class="mt-2 text-sm text-ink/65">
          Order {order.order_number} · placed{' '}
          {new Date(order.placed_at).toLocaleDateString('en-IN', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            timeZone: 'Asia/Kolkata',
          })}
        </p>

        {blocked ? (
          <Alert kind="info" title="Nothing to pay" class="mt-6">
            {blocked}
          </Alert>
        ) : (
          <Alert kind="info" class="mt-6">
            Your jars are still held for you. Nothing has been charged yet.
          </Alert>
        )}

        <div class="mt-6 rounded-3xl border border-mango-100 bg-white/70 p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-serif text-lg font-semibold text-ink">What you ordered</h2>
            <StatusBadge status={order.status} />
          </div>

          <ul class="mt-4 list-none space-y-3 p-0 text-sm">
            {items.map((item) => (
              <li class="flex items-start justify-between gap-3">
                <span class="min-w-0 text-ink/80">
                  {item.product_name}
                  <span class="block text-xs text-ink/55">
                    {item.variant_name} × {item.qty}
                  </span>
                </span>
                <Money paise={item.total_paise} class="text-ink" />
              </li>
            ))}
          </ul>

          <dl class="mt-4 space-y-2 border-t border-ink/10 pt-4 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-ink/70">Delivery to {view.shippingAddress.pincode}</dt>
              <dd class="text-ink">
                {order.shipping_paise === 0 ? 'Free' : <Money paise={order.shipping_paise} />}
              </dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-ink/10 pt-3 text-base font-semibold">
              <dt>To pay</dt>
              <dd><Money paise={order.total_paise} /></dd>
            </div>
          </dl>

          {!blocked && (
            <p class="mt-5">
              <Button type="button" size="lg" class="w-full" data-pay-button>
                Pay <Money paise={order.total_paise} /> now
              </Button>
            </p>
          )}

          <p class="mt-3 text-sm font-medium text-red-700" data-retry-error role="alert" hidden />

          {!blocked && (
            <noscript>
              <p class="mt-3 rounded-2xl border border-amber-600/30 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-950">
                Opening the payment page needs JavaScript. With it switched off, write to
                <a href="mailto:mothersgoldspice@gmail.com" class="font-medium underline">
                  mothersgoldspice@gmail.com
                </a>
                quoting {order.order_number} and we will send you a payment link.
              </p>
            </noscript>
          )}
        </div>

        <p class="mt-6 text-sm leading-relaxed text-ink/60">
          Changed your mind? Do nothing and the order releases itself, putting the jars back on the shelf.
        </p>
      </div>
    )
  }
</ShopLayout>

<script>
  /** Asks for a fresh gateway session and follows it. */
  const root = document.querySelector<HTMLElement>('[data-retry]');
  const button = root?.querySelector<HTMLButtonElement>('[data-pay-button]');

  if (root && button) {
    const csrf = document.querySelector<HTMLMetaElement>('meta[name=csrf-token]')?.content ?? '';
    const errorBox = root.querySelector<HTMLElement>('[data-retry-error]');

    button.addEventListener('click', () => {
      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'Opening the payment page…';
      if (errorBox) errorBox.hidden = true;

      void (async () => {
        try {
          const response = await fetch('/api/checkout/retry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
            body: JSON.stringify({ order_id: root.dataset.orderId, t: root.dataset.token || undefined }),
          });
          const payload = (await response.json()) as
            | { ok: true; data: { checkoutUrl: string } }
            | { ok: false; error: { message: string } };
          if (!payload.ok) throw new Error(payload.error.message);
          window.location.assign(payload.data.checkoutUrl);
        } catch (err) {
          if (errorBox) {
            errorBox.textContent = err instanceof Error ? err.message : 'We could not open the payment page.';
            errorBox.hidden = false;
          }
          button.disabled = false;
          button.textContent = original;
        }
      })();
    });
  }
</script>
